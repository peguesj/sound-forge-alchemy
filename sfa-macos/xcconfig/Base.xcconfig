// Sound Forge Alchemy — macOS Native
// Base.xcconfig: values shared by all configurations
//
// This file is #include'd by Debug.xcconfig and Release.xcconfig.
// Do NOT set environment-specific values here.

PRODUCT_BUNDLE_IDENTIFIER = com.soundforgealchemy.mac
MACOSX_DEPLOYMENT_TARGET = 14.0
SWIFT_VERSION = 5.0

// Marketing version and build number are managed by Fastlane / agvtool.
// MARKETING_VERSION and CURRENT_PROJECT_VERSION are kept in the .xcodeproj
// to allow `fastlane increment_build_number` to function correctly.

// Hardened Runtime — required for notarization
ENABLE_HARDENED_RUNTIME = YES

// Universal Binary (Apple Silicon + Intel)
ARCHS = arm64 x86_64
ONLY_ACTIVE_ARCH = NO

// Strip debug symbols from release builds (overridden in Debug.xcconfig)
STRIP_INSTALLED_PRODUCT = YES
COPY_PHASE_STRIP = NO

// Inject server URL into Info.plist so Swift can read it at runtime:
//   Bundle.main.infoDictionary?["SFA_SERVER_URL"] as? String
SFA_SERVER_URL = $(SFA_SERVER_URL)
