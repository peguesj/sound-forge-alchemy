// Sound Forge Alchemy — macOS Native
// Release.xcconfig: production / distribution configuration
//
// Wire this file to the "Release" build configuration in Xcode:
//   Project > Info > Configurations > Release > SoundForgeAlchemy: xcconfig/Release
//
#include "Base.xcconfig"

// Single-bundle runtime. Release builds should not depend on a server URL.
SFA_RUNTIME_MODE = bundled

// Optimisation
GCC_OPTIMIZATION_LEVEL = s
SWIFT_OPTIMIZATION_LEVEL = -O
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
STRIP_INSTALLED_PRODUCT = YES

// Manual signing — Fastlane Match manages certs
CODE_SIGN_STYLE = Manual
DEVELOPMENT_TEAM = $(TEAM_ID)
CODE_SIGN_IDENTITY = Developer ID Application

// Universal Binary
ONLY_ACTIVE_ARCH = NO

// Dead-code stripping
DEAD_CODE_STRIPPING = YES
